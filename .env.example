TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GEMINI_API_KEYS_FILE=config/gemini_api_keys.txt

BOT_ADMIN_IDS=

OUTPUT_DIR=outputs
TEMP_DIR=temp
LOG_DIR=logs

MAX_VIDEO_DURATION_MINUTES=60
MAX_CLIPS_PER_VIDEO=5
DEFAULT_CLIP_DURATION=30
DEFAULT_OUTPUT_RATIO=9:16
DEFAULT_CAPTION_LANGUAGE=id
DEFAULT_OUTPUT_QUALITY=medium

ENABLE_SUBTITLE_DEFAULT=true

ENABLE_WATERMARK_DEFAULT=false
WATERMARK_DEFAULT_TEXT=
WATERMARK_DEFAULT_POSITION=top-center
WATERMARK_DEFAULT_OPACITY=0.35
WATERMARK_DEFAULT_FONT_SIZE=28

WHISPERX_MODEL=small
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8

GEMINI_MODEL=gemini-1.5-flash
YTDLP_COOKIES_FILE=config/youtube_cookies.txt
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_JS_RUNTIMES=node,deno
YTDLP_REMOTE_COMPONENTS=ejs:github
YTDLP_PLAYER_CLIENTS=android,web,mweb,tv
MAX_CONCURRENT_JOBS=2

TELEGRAM_MAX_FILE_SIZE_MB=50
AUTO_DELETE_TEMP_FILES=true
AUTO_DELETE_OUTPUT_AFTER_SEND=false
